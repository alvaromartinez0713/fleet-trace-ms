# Copy this file to .env for local runs. These are safe local defaults and contain no secrets.

# Application
APP_NAME=ingest
APP_ENV=development
APP_VERSION=0.1.0

# HTTP server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# Logging
# LOG_LEVEL: debug, info, warn, error
# LOG_FORMAT: json, text
LOG_LEVEL=info
LOG_FORMAT=json

# Kafka (plaintext on localhost, no topic names here)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ingest
KAFKA_CONSUMER_GROUP=ingest
KAFKA_DIAL_TIMEOUT=10s
KAFKA_WRITE_TIMEOUT=10s
KAFKA_READ_TIMEOUT=10s

# OpenTelemetry (standard OTEL_* names read by the OTel SDK)
# Set OTEL_ENABLED=false to run without exporting traces.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ingest
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
